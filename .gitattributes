# Normalise line endings in the repository, and check out whatever the platform
# uses. Without this, every commit from Windows warns about LF being replaced.
* text=auto eol=lf

# Seed data transcribed from the Claude Design export by script. It ships in the
# build, so it is not vendored — but a 480KB diff of delivery records is noise in
# a review, and none of it is hand-edited.
src/data/business.ts linguist-generated
src/data/catalog.ts  linguist-generated
src/data/hrms.ts     linguist-generated
src/data/org.ts      linguist-generated
src/data/people.ts   linguist-generated
src/data/deliveries.json linguist-generated
src/data/production.ts linguist-generated
src/data/quality-log.json linguist-generated
src/data/deliveries.json  linguist-generated

