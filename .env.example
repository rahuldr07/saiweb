# Postgres. The application connects as a role that is NOT the table owner and
# NOT a superuser — row-level security is bypassed for both, which would silently
# defeat tenant isolation. See server/db/rls.sql.
DATABASE_URL=postgres://app_user:change-me@localhost:5432/titlecrm

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the front end runs, and where the API answers.
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
PORT=8787

# The Vite dev server proxies /api here.
VITE_API_URL=http://localhost:8787
