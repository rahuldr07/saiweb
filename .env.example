# Postgres — two roles, because the two jobs have opposite requirements.
#
# The owner. Creates tables and loads seed data, and holds BYPASSRLS so it can
# write the workspace rows that every policy scopes against. Used by
# `npm run db:push`, `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/titlecrm

# The application role. Owns nothing and bypasses nothing, so the policies in
# server/db/rls.sql actually apply to it. This is the one the server connects as,
# and it is what makes tenant isolation real rather than decorative. The server
# refuses to start if this role turns out to be an owner or a superuser.
#
# Created by rls.sql — pass the same password you use here:
#   psql "$DATABASE_URL" -v app_password="…" -f server/db/rls.sql
APP_DATABASE_URL=postgres://app_user:change-me@localhost:5432/titlecrm

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the front end runs, and where the API answers.
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
PORT=8787

# The Vite dev server proxies /api here.
VITE_API_URL=http://localhost:8787
